	"item": [
		{
			"name": "🔑 Autenticação",
			"item": [
				{
					"name": "Registrar Usuário",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nickname\": \"joaodev\",\n  \"email\": \"joao@email.com\",\n  \"hashedPassword\": \"SenhaSegura123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Cadastra um novo usuário no sistema."
					},
					"response": []
				},
				{
					"name": "Login de Usuário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData && jsonData.token) {",
									"        pm.collectionVariables.set(\"bearerToken\", jsonData.token);",
									"        console.log(\"Token JWT capturado e salvo na variável bearerToken!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"joao@email.com\",\n  \"Password\": \"SenhaSegura123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica o usuário. Ao ter sucesso, o token JWT retornado é automaticamente salvo na variável 'bearerToken' para autenticar as demais requisições."
					},
					"response": []
				}
			]
		},
		{
